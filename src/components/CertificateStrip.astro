---
// Endless horizontal strip of dealer certificates and awards.
// Pictures live in src/assets/certificates/ (see src/data/certificates.ts).
// On the live site only items with a picture are shown, and the whole
// section disappears if there are none yet. In `npm run dev` the missing
// ones appear as dashed placeholders so you can see what is still needed.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { certificates } from '../data/certificates';

interface Props {
  heading?: string;
  intro?: string;
}
const {
  heading = 'Dealer certificates & awards',
  intro = 'Authorisation certificates from the brands we sell, and recognition the shop has received.',
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/certificates/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const find = (name: string) => Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.[^.]+$/, '') === name)?.[1].default;

const items = await Promise.all(
  certificates
    .map((c) => ({ ...c, img: find(c.file) }))
    .filter((c) => (c.img && c.title) || import.meta.env.DEV)
    .map(async (c) => ({ ...c, full: c.img ? (await getImage({ src: c.img, width: 1600, format: 'webp' })).src : null })),
);
// Seconds per full loop: slow enough to read each card.
const duration = `${Math.max(items.length, 4) * 5}s`;
---

{
  items.length > 0 && (
    <section class="section section--paper" aria-labelledby="certs">
      <div class="wrap">
        <p class="eyebrow">Proof, not promises</p>
        <h2 id="certs">{heading}</h2>
        <p class="lead">{intro}</p>
      </div>
      <div class="marquee" style={`--duration:${duration}`}>
        <div class="marquee-track">
          {[0, 1].map((copy) =>
            items.map((c) => (
              <figure class:list={['cert', !c.img && 'cert--placeholder']} aria-hidden={copy === 1 ? 'true' : undefined}>
                {c.img ? (
                  <a href={c.full} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined}>
                    <div class="cert-img">
                      <Image src={c.img} alt={`${c.title} certificate, Cee Bee Enterprises Hazaribagh`} width={440} loading="lazy" />
                    </div>
                    <figcaption>{c.title}</figcaption>
                  </a>
                ) : (
                  <>
                    <div class="cert-img">{`TODO: src/assets/certificates/${c.file}.jpg`}</div>
                    <figcaption>{c.title || 'TODO: award name, given by, year'}</figcaption>
                  </>
                )}
              </figure>
            )),
          )}
        </div>
      </div>
    </section>
  )
}
