---
// Real-photo slot. Drop a photo into src/assets/photos/ named `<name>.jpg`
// (or .jpeg/.png/.webp) and it appears here automatically, converted to
// AVIF/WebP with explicit width/height. Until then a plain wood-texture panel
// is shown (labelled with the expected file name only in `npm run dev`).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { name, alt, ratio = '4 / 3', sizes = '(min-width: 960px) 560px, 100vw', eager = false, class: cls } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const match = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.[^.]+$/, '') === name)?.[1].default;
---

{
  match ? (
    <Picture
      src={match}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[400, 700, 1100]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class:list={['photo', cls]}
      style={`aspect-ratio:${ratio}`}
    />
  ) : (
    <div class:list={['photo-slot', cls]} style={`aspect-ratio:${ratio}`} aria-hidden="true">
      {import.meta.env.DEV && <span>{`{{FILL: photo src/assets/photos/${name}.jpg}}`}</span>}
    </div>
  )
}
