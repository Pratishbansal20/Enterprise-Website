---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CategoryGrid from '../../components/CategoryGrid.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import { SITE } from '../../config/site';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
];
const wa = 'Hi, I want price and availability for interior products.';
---

<Base
  title="Interior Products in Hazaribag | Plywood, Hardware, Décor"
  description="Interior products at Cee Bee Enterprises, Hazaribag: plywood, laminates, locks, kitchen hardware, wall panels, wallpaper, King Koil. WhatsApp for prices."
  path="/products/"
  alternates={{ en: '/products/', hi: '/hi/products/' }}
  breadcrumbs={crumbs}
  wa={wa}
>
  <PageHero crumbs={crumbs} h1="Interior Products & Hardware in Hazaribag" eyebrow="Products">
    <p class="lead">
      Cee Bee Enterprises (CB Decor) stocks interior products in Hazaribag for every stage of a home or shop interior, from the plywood carcass
      to the last handle, wall panel and mattress. Pick a category to see the sizes, grades and brands we carry, and tips on choosing.
    </p>
    <ContactButtons wa={wa} placement="products-hero" />
  </PageHero>

  <section class="section">
    <div class="wrap">
      <CategoryGrid headingLevel="h2" />
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap narrow prose">
      <h2>Why don’t you show prices online?</h2>
      <p>
        <strong>Rates for plywood, laminates and hardware change with company price lists, so a price online would soon be wrong.</strong> WhatsApp us
        the product, brand, size and quantity and we will reply with today’s price and stock. Contractors can send a full material list for one
        combined quote.
      </p>
      <h2>Can I see products before buying?</h2>
      <p>
        Yes. Visit the showroom near Bajrangi Chowk. We are open {SITE.hoursDisplay}
      </p>
    </div>
  </section>
</Base>
