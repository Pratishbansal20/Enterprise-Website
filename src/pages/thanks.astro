---
import Base from '../layouts/Base.astro';
import ContactButtons from '../components/ContactButtons.astro';
---

<Base title="Thank you | Cee Bee Enterprises (CB Decor)" description="Your quote request has been sent." path="/thanks/" noindex>
  <section class="section">
    <div class="wrap narrow center">
      <h1>Thank you, we’ve got your request</h1>
      <p class="lead" style="margin-inline:auto">
        We will reply on WhatsApp or by phone with prices and availability. If it’s urgent, call or WhatsApp us now.
      </p>
      <div class="btn-row" style="justify-content:center">
        <ContactButtons wa="Hi, I just sent a quote request on your website." placement="thanks" />
      </div>
      <p class="more-link"><a href="/products/">Back to products</a></p>
    </div>
  </section>
  <script is:inline>
    window.gtag && gtag('event', 'generate_lead', { form: 'quote' });
  </script>
</Base>
