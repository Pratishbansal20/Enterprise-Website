---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactButtons from '../components/ContactButtons.astro';
import CertificateStrip from '../components/CertificateStrip.astro';
import { brands } from '../data/brands';
import { categoryBySlug } from '../data/categories';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Brands', path: '/brands/' },
];
const short = (n: string) => n.replace(/ \(.*\)/, '');
const wa = 'Hi, I want to check availability of a brand.';
---

<Base
  title="Authorised Dealer in Hazaribag | Century, Godrej, Merino"
  description="Authorised dealer in Hazaribag for Century, Greenply, Royale Touche, Merino, Godrej, Ebco, Pidilite, Excel & King Koil. Ask stock on WhatsApp."
  path="/brands/"
  breadcrumbs={crumbs}
  wa={wa}
>
  <PageHero crumbs={crumbs} h1="Authorised Dealer for Leading Brands in Hazaribag" eyebrow="Brands">
    <p class="lead">
      Cee Bee Enterprises (CB Decor), near Bajrangi Chowk, is an authorised dealer in Hazaribag for {brands.length} brands:
      {' '}{brands.map((b) => short(b.name)).join(', ').replace(/, ([^,]*)$/, ' and $1')}. Buying from an authorised dealer means genuine products and
      a proper bill for the manufacturer’s warranty.
    </p>
    <ContactButtons wa={wa} placement="brands-hero" />
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="grid grid--3">
        {
          brands.map((b) => (
            <article class="card" id={b.id}>
              <h2 style="font-size:1.5rem">{short(b.name)} dealer in Hazaribag</h2>
              <p class="muted">Known for {b.makes}.</p>
              <p>
                <strong>What we sell:</strong> {b.weStock}
              </p>
              <p class="small">
                {b.categories.map((slug, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`/products/${slug}/`}>{categoryBySlug(slug).short}</a>
                  </>
                ))}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CertificateStrip heading="Our dealer certificates" intro="Authorisation certificates from the brands listed on this page." />

  <section class="section section--sand">
    <div class="wrap narrow">
      <h2>Do you stock other brands too?</h2>
      <p>
        Yes, some categories such as PVC boards, ACP sheets and wall panels come from other manufacturers. Ask us on WhatsApp which brands are in
        stock for the product you need.
      </p>
    </div>
  </section>
</Base>
